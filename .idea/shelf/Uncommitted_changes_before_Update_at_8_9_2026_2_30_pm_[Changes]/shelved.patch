+/**
+ * A job seeker can only cancel while the application is still sitting
+ * unopened in the employer's queue. The moment the employer opens it,
+ * ApplicationDetailScreen.kt (employer side) flips the status straight from
+ * "Pending" to "Viewed" -- from that point on (Viewed, Shortlisted,
+ * Interview, ...) the employer is already acting on it, so cancellation is
+ * locked out.
+ */
 internal fun JobApplication.canCancel(): Boolean {
     val normalized = status.trim().lowercase()
     if (normalized.isBlank()) return true
-    return normalized in setOf(
-        "pending",
-        "applied",
-        "submitted",
-        "viewed",
-        "shortlisted",
-        "interview"
-    )
+    return normalized in setOf("pending", "applied", "submitted")
 }
 
