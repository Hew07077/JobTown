+    // "Present" plus every year from startYear onward -- never a year before
+    // it -- so the End year dropdown can't offer a value that would put the
+    // entry's timeline backwards (e.g. start 2026, end 2023).
+    val endYearOptions = remember(startYear) { endYearOptionsFrom(startYear) }
+
+    // If the user picks a later start year after already choosing an end
+    // year, snap the now-invalid end year back to "Present" instead of
+    // silently leaving an end-before-start value selected.
+    LaunchedEffect(startYear) {
+        if (endYear != "Present" && endYear.toIntOrNull()?.let { it < (startYear.toIntOrNull() ?: 0) } == true) {
