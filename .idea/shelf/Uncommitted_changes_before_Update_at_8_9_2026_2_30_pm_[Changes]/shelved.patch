+/**
+ * Builds the End-year dropdown options for a given Start-year selection:
+ * "Present" plus every year from [startYear] through the most recent year in
+ * [ProfileOptions.YEARS] -- never a year before it. Falls back to the full
+ * list if [startYear] isn't a parseable year (e.g. blank on first render).
+ */
+private fun endYearOptionsFrom(startYear: String): List<String> {
+    val startNum = startYear.toIntOrNull() ?: return ProfileOptions.YEARS
+    return ProfileOptions.YEARS.filter { it == "Present" || (it.toIntOrNull() ?: 0) >= startNum }
+}
